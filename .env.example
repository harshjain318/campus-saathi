# Copy to .env and fill in. Never commit .env.
# Create a key at https://app.gnani.ai/voice (3 free keys per account).
GNANI_API_KEY=your-gnani-api-key

# Optional overrides
# GNANI_STT_MODEL=prisma-v3.0        # or prisma-v2.5
# GNANI_STT_LANGUAGES=hi-IN,en-IN
# GNANI_STT_FORMAT=codemix
# GNANI_TTS_MODEL=timbre-v2.5
# GNANI_TTS_VOICE_HI=Nalini
# GNANI_TTS_VOICE_EN=Kaveri
# INSTITUTE_NAME=your college name

# Optional: Evon (open weights from Hugging Face) served via vLLM or similar, OpenAI-compatible
# EVON_BASE_URL=http://localhost:8001/v1
# EVON_MODEL=gnani-ai/evon
